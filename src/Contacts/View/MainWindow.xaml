<Window x:Class="Contacts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:View.ViewModel"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="600" 
        Width="800"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen" 
        Icon="ContactsApp_96x96.ico" >
    <Window.Resources>
        <viewModel:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="70*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Background="White"
                HorizontalAlignment="Left" 
                Width="3" 
                Grid.Column="1"/>
        <Rectangle Grid.Column="0" Fill="#f8f8f8" />
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Content="Add"  
                Grid.Row="2" 
                Grid.Column="0"
                Height="25"
                Margin="0,0,1.5,0"
                Command="{Binding AddCommand}"/>
            <Button Content="Edit"  
                Grid.Row="2" 
                Grid.Column="1"
                Height="25"
                Margin="1.5,0,1.5,0" 
                Command="{Binding EditCommand}"/>
            <Button Content="Remove"  
                Grid.Row="2" 
                Grid.Column="2"
                Height="25"
                Margin="1.5,0,0,0"
                Command="{Binding RemoveCommand}"/>
            <ListBox ItemsSource="{Binding Contacts}" 
                DisplayMemberPath="Name"
                SelectedItem="{Binding CurrentContact}"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Margin="0,3,0,3"/>
            <TextBlock HorizontalAlignment="Left" 
                Text="Find:" 
                Height="18" 
                Width="30"/>
            <TextBox Grid.Column="0" 
                Grid.ColumnSpan="3"
                Margin="30,0,0,0"
                Height="18"/>
        </Grid>
        <Image Grid.Column="1" 
               Height="100" 
               Width="100" 
               HorizontalAlignment="Left" 
               VerticalAlignment="Top" 
               Margin="8,29,0,0" 
               Source="photo_placeholder_100x100.png"/>
        <StackPanel Grid.Column="1" 
                Margin="111,8,8,0" 
                Height="125"
                VerticalAlignment="Top">
            <TextBlock TextWrapping="Wrap" 
                Height="18"
                VerticalAlignment="Center"
                Text="Name:"
                Margin="0,0,0,3"/>
            <TextBox TextWrapping="Wrap"
                Height="18"
                Margin="0,0,0,3"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{Binding IsEditing}"/>
            <TextBlock TextWrapping="Wrap" 
                Height="18"
                Text="Phone Number:"
                Margin="0,0,0,3" />
            <TextBox TextWrapping="Wrap"
                Height="18"
                Margin="0,0,0,3"
                Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{Binding IsEditing}"/>
            <TextBlock TextWrapping="Wrap" 
                Height="18"
                Text="Email:"
                Margin="0,0,0,3"/>
            <TextBox TextWrapping="Wrap"
                Height="18"
                Margin="0,0,0,3"
                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{Binding IsEditing}"/>
        </StackPanel>
        <Button Grid.Column="1" 
                Content="Apply" 
                Width="75"
                Height="25"
                Margin="111,183,0,0" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
                Visibility="{Binding IsApplyVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Command="{Binding ApplyCommand}"/>
    </Grid>
</Window>
