<Window x:Class="Contacts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Contacts"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="400" 
        Width="500"
        WindowStartupLocation="CenterScreen" 
        Icon="ContactsApp_96x96.ico" >
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="Edit Contact" 
                  Margin="3">
            <StackPanel Margin="0">
                <Label Content="Name:" 
                       Height="25" />
                <TextBox TextWrapping="Wrap" 
                            Height="21"
                            Margin="4,4,0,0"
                            Text="{Binding Name, Mode=Default, UpdateSourceTrigger=PropertyChanged}">
                </TextBox>
                <Label Content="Email:" 
                       Height="25" />
                <TextBox TextWrapping="Wrap" 
                            Height="21"
                            Margin="4,4,0,0"
                            Text="{Binding Phone, Mode=Default, UpdateSourceTrigger=PropertyChanged}">
                </TextBox>
                <Label Content="Phome Number:" 
                       Height="25" />
                <TextBox TextWrapping="Wrap" 
                            Height="21"
                            Margin="4,4,0,0"
                            Text="{Binding Email, Mode=Default, UpdateSourceTrigger=PropertyChanged}">
                </TextBox>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Read Contact" 
                  Margin="3"
                  Grid.Column="1">
            <StackPanel Margin="0">
                <Label Content="Name:" 
                       Height="25" />
                <Label Content="{Binding Name, Mode=Default}"
                       Height="25" 
                       FontWeight="Bold" />
                <Label Content="Email:" 
                       Height="25" />
                <Label Content="{Binding Phone, Mode=Default}" 
                       Height="25" 
                       FontWeight="Bold" />
                <Label Content="Phone Number:" 
                       Height="25" />
                <Label Content="{Binding Email, Mode=Default}" 
                       Height="25" 
                       FontWeight="Bold" />
            </StackPanel>
        </GroupBox>

        <Grid Grid.Column="1" 
              Grid.Row="1" 
              Margin="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Load"  
                    Height="25" 
                    Width="75" 
                    Grid.Column="2" 
                    Margin="3"
                    Command="{Binding LoadCommand}"/>
            <Button Content="Save"  
                    Height="25" 
                    Width="75" 
                    Grid.Column="1" 
                    Margin="3"
                    Command="{Binding SaveCommand}"/>
        </Grid>
    </Grid>
</Window>
