<Window x:Class="Contacts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:View.Converters"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="600" 
        Width="800"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen" 
        Icon="Resources\ContactsApp_96x96.ico" >
    <Window.Resources>
        <viewModel:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <DataTemplate x:Key="contactTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Image Grid.Column ="0" 
                       Margin="3"
                       Height="34"
                       Source="Resources\photo_placeholder_100x100.png">
                    <Image.Clip>
                        <EllipseGeometry Center="17,17" 
                                         RadiusX="16" 
                                         RadiusY="16"/>
                    </Image.Clip>
                </Image>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="3">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Phone}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0,3*"/>
            <ColumnDefinition Width="0,7*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Background="White"
                HorizontalAlignment="Left" 
                Width="3" 
                Grid.Column="1"/>
        <Rectangle Grid.Column="0" Fill="#f8f8f8" />
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Content="Add"  
                Grid.Row="2" 
                Grid.Column="0"
                Height="25"
                Margin="0,0,3,0"
                Command="{Binding AddCommand}"/>
            <Button Content="Edit"  
                Grid.Row="2" 
                Grid.Column="1"
                Height="25"
                Margin="3,0,3,0" 
                Command="{Binding EditCommand}"/>
            <Button Content="Remove"  
                Grid.Row="2" 
                Grid.Column="2"
                Height="25"
                Margin="3,0,0,0"
                Command="{Binding RemoveCommand}"/>
            <ListBox ItemsSource="{Binding Contacts}" 
                SelectedItem="{Binding CurrentContact}"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Margin="0,3,0,3"
                ItemTemplate="{StaticResource contactTemplate}"/>
            <TextBlock HorizontalAlignment="Left" 
                Text="Find:" 
                Height="18" 
                Width="30"/>
            <TextBox Grid.Column="0" 
                Grid.ColumnSpan="3"
                Margin="30,0,0,0"
                Height="18"/>
        </Grid>
        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" 
                    Grid.Row="0"
                    Height="100" 
                    Width="100" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Margin="0,21,3,0" 
                    Source="Resources\photo_placeholder_100x100.png"
				    />
            <StackPanel Grid.Column="1"
                    Grid.Row="0"
                    Margin="3,0,0,0"
                    Height="auto"
                    VerticalAlignment="Top">
                <TextBlock TextWrapping="Wrap" 
                    Height="18"
                    VerticalAlignment="Center"
                    Text="Name:"
                    Margin="0,0,0,3"/>
                <TextBox TextWrapping="Wrap"
                    Height="18"
                    Margin="0,0,0,3"
                    Text="{Binding CurrentContact.Name, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding IsEditing}"/>
                <TextBlock TextWrapping="Wrap" 
                    Height="18"
                    Text="Phone Number:"
                    Margin="0,0,0,3" />
                <TextBox TextWrapping="Wrap"
                    Height="18"
                    Margin="0,0,0,3"
                    Text="{Binding CurrentContact.Phone, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding IsEditing}"/>
                <TextBlock TextWrapping="Wrap" 
                    Height="18"
                    Text="Email:"
                    Margin="0,0,0,3"/>
                <TextBox TextWrapping="Wrap"
                    Height="18"
                    Margin="0,0,0,3"
                    Text="{Binding CurrentContact.Email, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding IsEditing}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Grid.Row="1"
                    Content="Apply" 
                    Width="75"
                    Height="25"
                    Margin="0,50,0,0" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                    Command="{Binding ApplyCommand}"/>
        </Grid>
    </Grid>
</Window>
